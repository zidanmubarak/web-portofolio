.bolt/

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# qa screenshot evidence (large binaries, regenerable)
/qa/evidence/**/*.png
/qa/evidence/**/*.jpg
/qa/evidence/**/*.webp

# design prototypes and art-direction docs are kept local only
/design/

# local working material — never published:
# source decks and provenance notes, QA runs, internal docs and agent skills
# stay on disk but out of the repository
/content/
/qa/
/docs/
/.hermes/

# leftover shadcn/ui CLI config: it points at components/ui and hooks that no
# longer exist in this codebase
/components.json