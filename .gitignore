# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.bolt/

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js (every terminal uses its own build dir, e.g. .next-t1 / .next-t3)
/.next/
/.next*
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (never commit secrets; keep the example only)
.env
.env*.local
.env.*
!.env.example

# offline tooling (scripts/<name>/ has its own venv/node_modules)
scripts/**/.venv
scripts/**/node_modules

# generated assets (derived cutouts, crops, signed SVGs stay out of the repo)
assets/derived/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
