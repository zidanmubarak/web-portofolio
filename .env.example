# Environment variables — copy to `.env.local` and fill in real values.
# Never commit `.env.local` or any file containing real secrets.

# --- Contact form (app/api/contact) — SMTP via nodemailer ---
# Host of the SMTP server (e.g. smtp.gmail.com)
EMAIL_HOST=
# 465 for implicit TLS (EMAIL_SECURE=true), 587 for STARTTLS
EMAIL_PORT=587
# "true" only when the port uses implicit TLS (usually 465)
EMAIL_SECURE=false
# SMTP account used to authenticate and as the "from" address
EMAIL_USER=
# SMTP password or app-specific password
EMAIL_PASS=
# Inbox that receives submitted messages
EMAIL_RECEIVER=

# --- Site metadata (sitemap, robots, Open Graph) ---
# Public canonical origin, no trailing slash. Used by T9.
NEXT_PUBLIC_SITE_URL=https://zidanmubarak.vercel.app
